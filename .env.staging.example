# Staging environment template — demo Wizard API + production Supabase.
# Copy to Vercel staging project or local .env.staging (never commit secrets).

NEXT_PUBLIC_SITE_URL=https://staging.wheelsrentacar.com.lb
WEBSITE_URL=https://staging.wheelsrentacar.com.lb

# Supabase (production project or dedicated staging project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Wizard DEMO — do not point staging at production Wizard until go-live approval
NEXT_PUBLIC_WHEELS_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/public
WHEELS_INTERNAL_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/v1
WHEELS_INTERNAL_API_TOKEN=

# Payment-deferred launch defaults
PAYMENT_METHOD_CASH=true
PAYMENT_METHOD_TRANSFER=true
PAYMENT_METHOD_OMT=true
PAYMENT_METHOD_WHISH_ONLINE=false
PAYMENT_METHOD_NEO=false

# Notifications (Resend)
NOTIFICATION_PROVIDER_KEY=
NOTIFICATION_FROM_EMAIL=bookings@wheelsrentacar.com.lb
NOTIFICATION_CRON_SECRET=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
