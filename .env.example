# Public envs (exposed to the client). Set in Vercel / .env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (optional — leave blank to disable error reporting locally)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=

# Mock layer toggle (Sprint 2+). Default ON; flip to "false" when real APIs land.
NEXT_PUBLIC_MOCK_API=true

# Wheels public booking API (Laravel). When NEXT_PUBLIC_USE_REAL_BOOKING_API is
# "true", booking handlers delegate to the live backend via
# lib/api/wheels-public (availability, booking-request, lookup, status).
# Everything else stays mocked. See docs/Implementation/19_backend_public_api.md.
NEXT_PUBLIC_WHEELS_API_BASE_URL=https://lucid-mclean.217-160-215-26.plesk.page/api/public
NEXT_PUBLIC_USE_REAL_BOOKING_API=false

# Wizard internal sync endpoint (server-only; never expose in browser code)
WHEELS_INTERNAL_API_BASE_URL=https://lucid-mclean.217-160-215-26.plesk.page/api/v1
WHEELS_INTERNAL_API_TOKEN=

# Website-owned backend persistence/auth (server-only)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Whish payment gateway (server-only)
WHISH_CHANNEL=
WHISH_SECRET=
WEBSITE_URL=http://localhost:3000

# Live integration test gate (off by default). Set to "1" locally or in the
# manual `live-smoke` GitHub Actions workflow to run
# tests/integration/wheels-public.live.test.ts against NEXT_PUBLIC_WHEELS_API_BASE_URL.
RUN_LIVE_API_TESTS=

# Analytics (Sprint 2+) — set per environment
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Never commit populated .env files to git.
