# Public envs (exposed to the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Website-owned backend persistence (server-only)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin dashboard server session auth (required in every environment)
ADMIN_PASSWORD=
ADMIN_OPS_ADMIN_USERNAMES=admin
ADMIN_CONTENT_EDITOR_USERNAMES=editor
ADMIN_SESSION_SECRET=

# Wheels public + internal booking API (Laravel)
WIZARD_PUBLIC_PARENT_ID=2
# REQUIRED in production — the site's own public origin (https://your-domain)
WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_WHEELS_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/public
WHEELS_INTERNAL_API_TOKEN=
WHEELS_INTERNAL_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/v1

# Payment methods
PAYMENT_METHOD_CASH=true
PAYMENT_METHOD_TRANSFER=true
PAYMENT_METHOD_OMT=true
PAYMENT_METHOD_WHISH_ONLINE=false
PAYMENT_METHOD_NEO=false

# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
NOTIFICATION_FROM_EMAIL=bookings@wheelsrentacar.com.lb
NOTIFICATION_FROM_NAME=Wheels Rent A Car

# Google Maps — Places Autocomplete on the delivery-address field
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Never commit populated .env files to git.
