# Public envs (exposed to the client). Set in Vercel / .env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (optional — leave blank to disable error reporting locally)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=

# Wheels public booking API (Laravel). Booking route handlers always delegate
# availability, booking-request, lookup, and status to this API.
# See docs/Implementation/19_backend_public_api.md.
# Demo (integration testing):
NEXT_PUBLIC_WHEELS_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/public
# Production: https://system.wheelsrentacar.com.lb/api/public

# Wizard internal sync endpoint (server-only; never expose in browser code)
WHEELS_INTERNAL_API_BASE_URL=https://adoring-hugle.85-215-232-144.plesk.page/api/v1
# Production: https://system.wheelsrentacar.com.lb/api/v1
# Adam may supply this as WIZARD_API_TOKEN; either name works (WHEELS_* preferred).
WHEELS_INTERNAL_API_TOKEN=
WIZARD_API_TOKEN=
# Company/parent id for the public booking website (returned in vehicle sync responses).
WIZARD_PUBLIC_PARENT_ID=2

# Website-owned backend persistence/auth (server-only)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin dashboard server session auth
# Required in every environment. No fallback defaults are allowed.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_OPS_ADMIN_USERNAMES=admin
ADMIN_CONTENT_EDITOR_USERNAMES=editor

# Whish payment gateway (server-only)
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_ENVIRONMENT=sandbox
WEBSITE_URL=http://localhost:3000

# Bank Audi NEO (server-only; sandbox scaffold until merchant credentials are issued)
NEO_MERCHANT_ID=
NEO_API_KEY=
NEO_ENVIRONMENT=sandbox

# Payment modules — individually activatable (Adam production handoff)
PAYMENT_METHOD_CASH=true
PAYMENT_METHOD_TRANSFER=true
PAYMENT_METHOD_OMT=true
PAYMENT_METHOD_WHISH_ONLINE=false
PAYMENT_METHOD_NEO=false

# Customer notifications (Resend)
NOTIFICATION_PROVIDER_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=bookings@wheelsrentacar.com.lb
NOTIFICATION_CRON_SECRET=

# Live integration test gate (off by default). Set to "1" locally or in the
# manual `live-smoke` GitHub Actions workflow to run
# tests/integration/wheels-public.live.test.ts against NEXT_PUBLIC_WHEELS_API_BASE_URL.
RUN_LIVE_API_TESTS=

# Analytics (Sprint 2+) — set per environment
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Never commit populated .env files to git.
